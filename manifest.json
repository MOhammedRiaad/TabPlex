{
    "manifest_version": 3,
    "name": "TabPlex",
    "version": "1.0.0",
    "description": "Give every task its own tabs. Park work with a note, resume it in one click, and organize tabs into groups. Private, on-device.",
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    },
    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },
    "action": {},
    "permissions": ["tabs", "tabGroups", "history", "sessions", "storage", "notifications", "bookmarks", "favicon"],

    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+T"
            }
        }
    },
    "web_accessible_resources": [
        {
            "resources": ["onboarding.html", "onboarding.css", "onboarding.js", "index.html", "assets/*"],
            "matches": ["<all_urls>"]
        }
    ]
}
