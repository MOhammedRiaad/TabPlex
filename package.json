{
    "name": "tabplex",
    "private": true,
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MOhammedRiaad/TabPlex.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "check:bundle": "node scripts/check-bundle-size.mjs",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,js,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{ts,js,json,md}\"",
        "preview": "vite preview",
        "prepare": "husky",
        "package": "node scripts/package-extension.mjs",
        "release:dry": "semantic-release --dry-run --no-ci",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "screenshots": "playwright test -c playwright.screenshots.config.ts",
        "build:privacy": "node scripts/build-privacy-page.mjs",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "framer-motion": "^12.23.26",
        "idb": "^8.0.3",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-router-dom": "^7.12.0",
        "tldraw": "^4.2.3",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.0",
        "@commitlint/config-conventional": "^20.3.0",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.63.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/chrome": "^0.1.32",
        "@types/node": "^26.6.4",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/react-router-dom": "^5.3.3",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "@vitejs/plugin-react": "^5.1.2",
        "@vitest/coverage-v8": "^5.0.3",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.3",
        "fake-indexeddb": "^6.2.5",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "jsdom": "^30.1.1",
        "lint-staged": "^16.2.7",
        "marked": "^15.0.12",
        "prettier": "^3.7.4",
        "semantic-release": "^25.0.9",
        "typescript": "^5.0.2",
        "typescript-eslint": "^8.51.0",
        "vite": "^7.3.0",
        "vite-plugin-static-copy": "^3.1.4",
        "vitest": "^5.0.3"
    }
}
